<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.oxsacool.thaivoice"
    android:versionCode="1"
    android:versionName="0.1.0-alpha.1">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28"/>

    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Only request the climate permission provided by the firmware. -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON"/>

    <uses-feature android:name="android.hardware.microphone" android:required="true"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <activity
            android:name="com.homeo.dashvoice.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name="com.homeo.dashvoice.KeepAliveJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>

        <service
            android:name="com.homeo.dashvoice.MicKeyService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <receiver android:name="com.homeo.dashvoice.BootReceiver" android:exported="true" android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.USER_PRESENT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
